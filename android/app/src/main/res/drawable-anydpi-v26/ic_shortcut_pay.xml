<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive, so the launcher fills its plate with Levels' cream rather than
     shrinking a round icon inside a white square. The pause badge sits top
     right: the launcher puts its own app badge bottom right. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_pay_bg"/>
    <foreground android:drawable="@drawable/ic_shortcut_pay_fg"/>
</adaptive-icon>
